{
    "name": "clippy",
    "displayName": "Clippy",
    "productName": "Clippy",
    "description": "Clipboard manager with RPC",
    "version": "0.30.0",
    "author": "AndreasArvidsson",
    "license": "MIT",
    "main": "out/main.js",
    "scripts": {
        "clean": "rm -rf out dist",
        "postinstall": "install-electron",
        "start": "electron-vite dev",
        "build": "electron-vite build",
        "package": "npm run clean && npm run build && tsx ./scripts/package.mts",
        "typecheck": "tsc -p . && tsc -p src/renderer",
        "lint:ts": "oxlint -c oxlint.config.mts --deny-warnings .",
        "lint:style": "stylelint --ignore-path .gitignore **/*.css",
        "lint:fmt": "oxfmt --check .",
        "lint": "npm run typecheck && npm run lint:ts && npm run lint:style && npm run lint:fmt",
        "fix:ts": "oxlint -c oxlint.config.mts --fix .",
        "fix:style": "stylelint --ignore-path .gitignore --fix **/*.css",
        "fix:fmt": "oxfmt .",
        "fix": "npm run fix:ts && npm run fix:style && npm run fix:fmt",
        "test": "tsx ./src/tests/runAllTests.ts"
    },
    "dependencies": {
        "bootstrap": "^5.3.8",
        "clipboard-event": "^1.6.0",
        "preact": "^10.29.1",
        "react-bootstrap-icons": "^1.11.6",
        "sharp": "^0.34.5",
        "talon-rpc": "^2.2.0",
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@electron/packager": "^20.0.0",
        "@preact/preset-vite": "^2.10.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.12.3",
        "@types/react": "^19.2.14",
        "electron-vite": "^5.0.0",
        "electron": "^42.0.1",
        "fast-glob": "^3.3.3",
        "mocha": "^11.7.5",
        "oxfmt": "^0.48.0",
        "oxlint-tsgolint": "^0.22.1",
        "oxlint": "^1.63.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint": "^17.11.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vite-plugin-purgecss": "^0.2.13"
    }
}
